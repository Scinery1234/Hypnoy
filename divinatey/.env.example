# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model and reasoning effort for interpretations
# ANTHROPIC_MODEL=claude-opus-5-5
# ORACLE_EFFORT=low

# Optional: ANU Quantum Random Numbers API key (https://quantumnumbers.anu.edu.au).
# Without it the seed falls back to hardware entropy.
# ANU_API_KEY=

# Optional server settings
# PORT=8787
# Free tier: different people (birth details) each IP may open per UTC day;
# each person opens all four chart systems
# FREE_CHARTS_PER_DAY=2
# RATE_LIMIT_PER_10MIN=40
# Set to 1 when running behind a reverse proxy so per-IP limits see real client IPs
# TRUST_PROXY=1

# Accounts (Supabase). Without these, accounts are off and free chart counts
# are kept in memory. Run supabase/migrations/*.sql in your project first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=           (public: sent to the browser for sign-in)
# SUPABASE_SERVICE_ROLE_KEY=   (secret: server only)
# Key for hashing IPs in the free chart count. Set it so counts survive restarts
# and are shared between instances.
# FREE_LIMIT_SECRET=

# Paid preview at /preview: all paid features unlocked for testing.
# Set to 0 to close it once payments are live.
# PAID_PREVIEW=1
# PREVIEW_CHAT_PER_10MIN=20
# Chart explanations and reading sections per IP per 10 minutes
# EXPLAIN_PER_10MIN=60
# Linked-chart chat: fast model for the small steps, and the weekly allowance
# ANTHROPIC_QUICK_MODEL=claude-haiku-5-5
# LINKED_QUESTIONS_PER_WEEK=5
# Skip the polish step after this long so linked replies beat host time limits
# LINKED_TIME_BUDGET_MS=25000

# Payments (Stripe). Run `npm run stripe:setup` once to create prices, the
# billing portal and the webhook (it prints STRIPE_WEBHOOK_SECRET).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_URL=https://your-site.example
